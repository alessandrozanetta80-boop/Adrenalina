rules_version = '2';

// REGOLE DI SICUREZZA — Adrenalina
//
// Queste regole sono l'unica cosa che protegge davvero i dati della
// squadra. Non il repository privato, non la chiave nell'app: quelle
// non contano. Conta questo file.
//
// Principio:
//   - chi non ha fatto l'accesso non vede e non scrive niente;
//   - chi ha fatto l'accesso legge tutto;
//   - scrive solo chi e' elencato nella raccolta "amministratori".
//
// La raccolta "amministratori" contiene un documento per ogni
// amministratore, con l'identificativo dell'account come nome del
// documento. Nessuno puo' modificarla dall'app: si aggiunge o si
// toglie un amministratore solo dalla console Firebase.
//
// Come caricarle: console.firebase.google.com -> Firestore Database ->
// Regole -> incolla questo file -> Pubblica. Passo per passo in ACCESSO.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticato() {
      return request.auth != null;
    }

    function amministratore() {
      return autenticato() &&
        exists(/databases/$(database)/documents/amministratori/$(request.auth.uid));
    }

    // L'elenco degli amministratori si legge (serve all'app per sapere
    // cosa mostrare) ma non si tocca da qui: solo dalla console.
    match /amministratori/{uid} {
      allow read: if autenticato();
      allow write: if false;
    }

    // Tutti i dati della squadra: lettura a chi e' entrato,
    // scrittura ai soli amministratori.
    match /squadre/{documento=**}          { allow read: if autenticato(); allow write: if amministratore(); }
    match /stagioni/{documento=**}         { allow read: if autenticato(); allow write: if amministratore(); }
    match /membri/{documento=**}           { allow read: if autenticato(); allow write: if amministratore(); }
    match /iscrizioni/{documento=**}       { allow read: if autenticato(); allow write: if amministratore(); }
    match /giornate/{documento=**}         { allow read: if autenticato(); allow write: if amministratore(); }
    match /presenze/{documento=**}         { allow read: if autenticato(); allow write: if amministratore(); }
    match /abbattimenti/{documento=**}     { allow read: if autenticato(); allow write: if amministratore(); }
    match /controlliSanitari/{documento=**} { allow read: if autenticato(); allow write: if amministratore(); }
    match /calendariBattuta/{documento=**} { allow read: if autenticato(); allow write: if amministratore(); }
    match /configCarne/{documento=**}      { allow read: if autenticato(); allow write: if amministratore(); }
    match /lottiCarne/{documento=**}       { allow read: if autenticato(); allow write: if amministratore(); }
    match /quoteCarne/{documento=**}       { allow read: if autenticato(); allow write: if amministratore(); }
    match /venditeCarne/{documento=**}     { allow read: if autenticato(); allow write: if amministratore(); }
    match /ritiriCarne/{documento=**}      { allow read: if autenticato(); allow write: if amministratore(); }
    match /meta/{documento=**}             { allow read: if autenticato(); allow write: if amministratore(); }

    // Tutto il resto e' chiuso. Se un domani si aggiunge una raccolta
    // va dichiarata qui sopra: finche' non lo e', nessuno la tocca.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
