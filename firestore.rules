rules_version = '2';

// REGOLE DI SICUREZZA — Adrenalina
//
// Queste regole sono l'unica cosa che protegge davvero i dati della
// squadra. Non il repository privato, non la chiave nell'app: quelle
// non contano. Conta questo file.
//
// Principio:
//   - entrano SOLO le persone elencate nella raccolta "amministratori";
//   - chiunque altro non legge e non scrive niente, nemmeno dopo
//     essersi autenticato con Google.
//
// La raccolta "amministratori" contiene un documento per ogni
// amministratore, con l'identificativo dell'account come nome del
// documento. Nessuno puo' modificarla dall'app: si aggiunge o si
// toglie un amministratore solo dalla console Firebase.
//
// Come caricarle: console.firebase.google.com -> Firestore Database ->
// Regole -> incolla questo file -> Pubblica. Passo per passo in ACCESSO.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticato() {
      return request.auth != null;
    }

    function amministratore() {
      return autenticato() &&
        exists(/databases/$(database)/documents/amministratori/$(request.auth.uid));
    }

    // L'elenco degli amministratori si legge (serve all'app per sapere
    // cosa mostrare) ma non si tocca da qui: solo dalla console.
    // Ognuno puo' controllare solo la propria voce: serve all'app per
    // sapere se sei autorizzato. Nessuno puo' modificarla da qui.
    match /amministratori/{uid} {
      allow read: if autenticato() && request.auth.uid == uid;
      allow write: if false;
    }

    // Tutti i dati della squadra: solo gli amministratori, sia in
    // lettura sia in scrittura.
    match /squadre/{documento=**}          { allow read, write: if amministratore(); }
    match /stagioni/{documento=**}         { allow read, write: if amministratore(); }
    match /membri/{documento=**}           { allow read, write: if amministratore(); }
    match /iscrizioni/{documento=**}       { allow read, write: if amministratore(); }
    match /giornate/{documento=**}         { allow read, write: if amministratore(); }
    match /presenze/{documento=**}         { allow read, write: if amministratore(); }
    match /abbattimenti/{documento=**}     { allow read, write: if amministratore(); }
    match /controlliSanitari/{documento=**} { allow read, write: if amministratore(); }
    match /calendariBattuta/{documento=**} { allow read, write: if amministratore(); }
    match /configCarne/{documento=**}      { allow read, write: if amministratore(); }
    match /lottiCarne/{documento=**}       { allow read, write: if amministratore(); }
    match /quoteCarne/{documento=**}       { allow read, write: if amministratore(); }
    match /venditeCarne/{documento=**}     { allow read, write: if amministratore(); }
    match /ritiriCarne/{documento=**}      { allow read, write: if amministratore(); }
    match /meta/{documento=**}             { allow read, write: if amministratore(); }

    // Registro delle operazioni gia' applicate: serve a non duplicare
    // una modifica ritentata dopo un timeout. Si crea e si legge, non
    // si modifica ne' si cancella: e' la memoria di cosa e' successo.
    match /operazioni/{operationId} {
      allow read, create: if amministratore();
      allow update, delete: if false;
    }

    // Contatori dei codici capo. Si aggiornano solo dentro una
    // transazione dell'app; nessuno li puo' cancellare, altrimenti
    // la numerazione ripartirebbe da capo.
    match /contatori/{nome} {
      allow read, create, update: if amministratore();
      allow delete: if false;
    }

    // Tutto il resto e' chiuso. Se un domani si aggiunge una raccolta
    // va dichiarata qui sopra: finche' non lo e', nessuno la tocca.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
